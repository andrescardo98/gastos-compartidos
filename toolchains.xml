<?xml version="1.0" encoding="UTF-8"?>
<!--
    Toolchain OPCIONAL para este proyecto.

    No se usa en el build normal: JAVA_HOME + maven.compiler.release=21 ya producen
    bytecode compatible con Java 21 aunque el JDK activo sea mas nuevo.

    Uso explicito (activa tambien el perfil del pom.xml):
        mvn -Pjdk21-toolchain -t toolchains.xml verify

    Alternativa: copiar este contenido a %USERPROFILE%\.m2\toolchains.xml para que
    Maven lo tome sin el flag -t.
-->
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 https://maven.apache.org/xsd/toolchains-1.1.0.xsd">
    <toolchain>
        <type>jdk</type>
        <provides>
            <version>21</version>
            <vendor>temurin</vendor>
        </provides>
        <configuration>
            <jdkHome>C:\Program Files\Eclipse Adoptium\jdk-21.0.12.8-hotspot</jdkHome>
        </configuration>
    </toolchain>
</toolchains>
